{
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments", "reactBitsReviewed", "features"],
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window", "repository", "reason", "readmeEvidence"],
        "properties": {
          "window": { "type": "string", "enum": ["daily", "weekly", "monthly", "design"] },
          "repository": { "type": "string" },
          "reason": { "type": "string" },
          "readmeEvidence": { "type": "string" }
        }
      }
    },
    "reactBitsReviewed": { "type": "array", "items": { "type": "string" } },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "repository", "brief", "reactBitsComponents", "route"],
        "properties": {
          "title": { "type": "string" },
          "repository": { "type": "string" },
          "brief": { "type": "string" },
          "route": { "type": "string" },
          "reactBitsComponents": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
