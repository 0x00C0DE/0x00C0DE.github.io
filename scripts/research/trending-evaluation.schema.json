{
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments", "features"],
  "properties": {
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window", "repository", "reason"],
        "properties": {
          "window": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
          "repository": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "repository", "brief"],
        "properties": {
          "title": { "type": "string" },
          "repository": { "type": "string" },
          "brief": { "type": "string" }
        }
      }
    }
  }
}
